generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMMERCE_OWNER
  FRONT_DESK
  KITCHEN
  DISPATCH
  RIDER
  EDITOR
  VIEWER
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BusinessType {
  RESTAURANT
  GROCERY
  HOTEL
  RECRUITMENT_AGENCY
  MANPOWER_CONSULTANCY
  HR_CONSULTANCY
  CLINIC
  RETAIL
  EDUCATION
  SERVICE_BUSINESS
  OTHER
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum BrandAssetType {
  LOGO
  BUSINESS_CARD
  POSTER
  PAMPHLET
  BROCHURE
  MENU
  PRODUCT_IMAGE
  REFERENCE_IMAGE
  REFERENCE_VIDEO
  DOCUMENT
}

enum ExtractionStatus {
  NOT_STARTED
  PENDING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  RIDER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  PAYMENT_COLLECTED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  CASH_ON_PICKUP
  CARD_ON_PICKUP
  ONLINE
  PICKUP_PAYMENT
}

enum PaymentStatus {
  PENDING
  COLLECTED
  PAID
  FAILED
  REFUNDED
  NOT_REQUIRED
  NOT_APPLICABLE
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum OrderSource {
  CUSTOMER_PWA
  MANUAL_WHATSAPP
  MANUAL_PHONE
  ADMIN
}

enum RiderAvailabilityStatus {
  AVAILABLE
  ASSIGNED
  OFFLINE
}

enum PromotionType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_DELIVERY
}

enum NotificationEventType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  ORDER_READY
  RIDER_ASSIGNED
  ORDER_PICKED_UP
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  PAYMENT_COLLECTED
  RECEIPT_READY
  ORDER_CANCELLED
}

enum CampaignType {
  RECRUITMENT
  PRODUCT
  MENU_ITEM
  SERVICE
  OFFER
  EVENT
  ANNOUNCEMENT
  COMPANY_PROFILE
}

enum CampaignStatus {
  DRAFT
  READY_FOR_GENERATION
  GENERATING
  GENERATED
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  FAILED
  ARCHIVED
}

enum MediaAssetType {
  IMAGE
  POSTER
  BANNER
  REEL
  VIDEO
  LOGO
  DOCUMENT
}

enum MediaCategory {
  BRAND
  RECRUITMENT
  PRODUCT
  MENU
  SERVICE
  OFFER
  COMPANY
  SOCIAL
  ORDERING_APP
}

enum MediaSourceType {
  UPLOADED
  GENERATED
  ENHANCED
  IMPORTED
}

enum StudioOutputType {
  TEXT
  POSTER
  STORYBOARD
  VIDEO
  EXPORT_PACKAGE
}

enum StudioJobType {
  POSTER_RENDER
  IMAGE_ENHANCE
  IMAGE_RESIZE
  VIDEO_ENHANCE
  VIDEO_ASSEMBLE
  PLATFORM_EXPORT
}

enum StudioJobStatus {
  SCHEDULED
  QUEUED
  SUBMITTING
  PROCESSING
  COMPLETED
  PUBLISHED
  FAILED
  CANCELLED
}

enum MediaPlacementType {
  ORDERING_HOMEPAGE_HERO
  ORDERING_PROMOTIONAL_BANNER
  ORDERING_CATEGORY_BANNER
  ORDERING_PRODUCT_IMAGE
  ORDERING_SPECIAL_OFFER
  ORDERING_POPUP
  ORDER_CONFIRMATION_PROMOTION
  COMPANY_HOMEPAGE
  COMPANY_SERVICE_SECTION
  COMPANY_OFFER_SECTION
  COMPANY_PROFILE
  RECRUITMENT_HOMEPAGE_HIRING_BANNER
  RECRUITMENT_OPEN_ROLES
  RECRUITMENT_JOB_PAGE
}

enum StudioMediaUsageType {
  COMMERCE_HOMEPAGE_BANNER
  COMMERCE_PRODUCT_IMAGE
  COMMERCE_CATEGORY_BANNER
  COMMERCE_OFFER_BANNER
  COMMERCE_ORDER_CONFIRMATION_PROMOTION
  COMMERCE_WHATSAPP_PROMOTION
  GENERAL_MARKETING
}

enum InventoryMode {
  TRACK_QUANTITY
  AVAILABILITY_ONLY
  ALWAYS_AVAILABLE
}

enum DietaryClassification {
  VEG
  NON_VEG
}

model Company {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  businessType         BusinessType @default(OTHER)
  industry             String?
  description          String?
  targetAudience       String?
  productsSummary      String?
  brandPersonality     String?
  preferredLanguage    String?
  defaultPlatformsJson Json?
  country              String?
  city                 String?
  address              String?
  latitude             Decimal?     @db.Decimal(10, 7)
  longitude            Decimal?     @db.Decimal(10, 7)
  phone                String?
  whatsapp             String?
  email                String?
  website              String?
  orderingSlug         String?      @unique
  commerceEnabled      Boolean      @default(false)
  studioEnabled        Boolean      @default(true)
  recruitmentEnabled   Boolean      @default(false)

  status Status @default(ACTIVE)

  users              User[]
  brandProfile       BrandProfile?
  brandAssets        BrandAsset[]
  productCategories  ProductCategory[]
  products           Product[]
  deliveryZones      DeliveryZone[]
  operatingHours     OperatingHours[]
  commerceSettings   CommerceBusinessSettings?
  branches           Branch[]
  customers          Customer[]
  orders             Order[]
  riders             Rider[]
  promotions         Promotion[]
  notificationEvents NotificationEvent[]
  campaigns          StudioCampaign[]
  mediaAssets        MediaAsset[]
  campaignInputs     CampaignInput[]
  campaignOutputs    CampaignOutput[]
  storyboards        Storyboard[]
  processingJobs     MediaProcessingJob[]
  mediaPlacements    MediaPlacement[]
  studioSettings     StudioSettings?
  studioTemplates    StudioTemplate[]
  studioActivities   StudioActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommerceBusinessSettings {
  id                      String   @id @default(uuid())
  companyId               String   @unique
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  displayName             String
  description             String?
  cuisinesJson            Json?
  currency                String   @default("AED")
  timezone                String   @default("Asia/Dubai")
  taxPercentage           Decimal  @default(5) @db.Decimal(5, 2)
  minimumOrderAmount      Decimal  @default(0) @db.Decimal(10, 2)
  deliveryCharge          Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold   Decimal? @db.Decimal(10, 2)
  preparationMinutes      Int      @default(30)
  deliveryRadiusKm        Decimal  @default(5) @db.Decimal(8, 2)
  deliveryEnabled         Boolean  @default(true)
  pickupEnabled           Boolean  @default(true)
  cashPaymentEnabled      Boolean  @default(true)
  cardOnDeliveryEnabled   Boolean  @default(true)
  onlinePaymentEnabled    Boolean  @default(false)
  acceptingOrders         Boolean  @default(true)
  temporaryClosureMessage String?
  logoMediaAssetId        String?
  coverMediaAssetId       String?
  logoPath                String?
  coverImagePath          String?
  terms                   String?
  cancellationPolicy      String?
  demoBusiness            Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Branch {
  id                    String                 @id @default(uuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  address               String?
  city                  String?
  phone                 String?
  whatsapp              String?
  email                 String?
  latitude              Decimal?               @db.Decimal(10, 7)
  longitude             Decimal?               @db.Decimal(10, 7)
  deliveryRadiusKm      Decimal                @default(5) @db.Decimal(8, 2)
  minimumOrderAmount    Decimal                @default(0) @db.Decimal(10, 2)
  deliveryFee           Decimal                @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal?               @db.Decimal(10, 2)
  preparationMinutes    Int                    @default(30)
  active                Boolean                @default(true)
  pickupEnabled         Boolean                @default(true)
  deliveryEnabled       Boolean                @default(true)
  temporarilyClosed     Boolean                @default(false)
  closureReason         String?
  hours                 BranchOperatingHours[]
  orders                Order[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model BranchOperatingHours {
  id        String  @id @default(uuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  closed    Boolean @default(false)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

model User {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  email        String @unique
  passwordHash String

  role   UserRole @default(COMPANY_ADMIN)
  status Status   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model BrandProfile {
  id                   String         @id @default(uuid())
  companyId            String         @unique
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tagline              String?
  logoPath             String?
  secondaryLogoPath    String?
  lightLogoPath        String?
  darkLogoPath         String?
  faviconPath          String?
  primaryColor         String         @default("#2563eb")
  secondaryColor       String         @default("#14b8a6")
  accentColor          String         @default("#f97316")
  backgroundColor      String         @default("#ffffff")
  textColor            String         @default("#111827")
  headingFont          String         @default("Inter")
  bodyFont             String         @default("Inter")
  brandTone            String?
  approvedKeywordsJson Json?
  restrictedWordsJson  Json?
  visualStyle          String?
  preferredImageStyle  String?
  preferredVideoStyle  String?
  defaultCallToAction  String?
  ctaStyle             String?
  instagramHandle      String?
  facebookPage         String?
  linkedinPage         String?
  whatsappNumber       String?
  approvalStatus       ApprovalStatus @default(DRAFT)
  approvedAt           DateTime?
  assets               BrandAsset[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model BrandAsset {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandProfileId   String?
  brandProfile     BrandProfile?    @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  assetType        BrandAssetType
  originalFilename String
  storedFilename   String
  filePath         String
  mimeType         String
  fileSize         Int
  extractionStatus ExtractionStatus @default(NOT_STARTED)
  approved         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([companyId])
  @@index([brandProfileId])
}

model ProductCategory {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  imagePath      String?
  displayOrder   Int       @default(0)
  active         Boolean   @default(true)
  availableFrom  String?
  availableUntil String?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id                    String                 @id @default(uuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId            String?
  category              ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                  String
  slug                  String
  shortDescription      String?
  description           String?
  regularPrice          Decimal                @db.Decimal(10, 2)
  promotionalPrice      Decimal?               @db.Decimal(10, 2)
  imagePath             String?
  vegetarian            Boolean                @default(false)
  dietaryClassification DietaryClassification?
  spicy                 Boolean                @default(false)
  bestseller            Boolean                @default(false)
  inStock               Boolean                @default(true)
  inventoryMode         InventoryMode          @default(ALWAYS_AVAILABLE)
  inventoryQuantity     Int?
  lowStockThreshold     Int?
  sku                   String?
  taxable               Boolean                @default(true)
  studioMediaAssetId    String?
  available             Boolean                @default(true)
  featured              Boolean                @default(false)
  preparationMinutes    Int?
  displayOrder          Int                    @default(0)
  orderItems            OrderItem[]
  mediaAssets           MediaAsset[]
  campaigns             StudioCampaign[]
  variants              ProductVariant[]
  addOnGroups           ProductAddOnGroup[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([categoryId])
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal? @db.Decimal(10, 2)
  priceDelta   Decimal  @default(0) @db.Decimal(10, 2)
  active       Boolean  @default(true)
  displayOrder Int      @default(0)

  @@unique([productId, name])
  @@index([productId])
}

model AddOnGroup {
  id                String              @id @default(uuid())
  companyId         String
  name              String
  required          Boolean             @default(false)
  minSelections     Int                 @default(0)
  maxSelections     Int                 @default(1)
  multipleSelection Boolean             @default(false)
  active            Boolean             @default(true)
  displayOrder      Int                 @default(0)
  addOns            AddOn[]
  products          ProductAddOnGroup[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model AddOn {
  id                    String                 @id @default(uuid())
  groupId               String
  group                 AddOnGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                  String
  price                 Decimal                @default(0) @db.Decimal(10, 2)
  dietaryClassification DietaryClassification?
  active                Boolean                @default(true)
  displayOrder          Int                    @default(0)

  @@unique([groupId, name])
  @@index([groupId])
}

model ProductAddOnGroup {
  productId String
  groupId   String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

model DeliveryZone {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  radiusKm           Decimal  @db.Decimal(8, 2)
  deliveryCharge     Decimal  @db.Decimal(10, 2)
  minimumOrderAmount Decimal  @db.Decimal(10, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

model OperatingHours {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  closed    Boolean @default(false)

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

model Customer {
  id                         String            @id @default(uuid())
  companyId                  String
  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                       String
  mobile                     String
  email                      String?
  marketingConsent           Boolean           @default(false)
  whatsappOperationalConsent Boolean           @default(false)
  whatsappConsentAt          DateTime?
  orders                     Order[]
  addresses                  CustomerAddress[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@unique([companyId, mobile])
  @@index([companyId])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  addressLine String
  building    String?
  apartment   String?
  area        String?
  landmark    String?
  city        String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Order {
  id                          String               @id @default(uuid())
  companyId                   String
  company                     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId                  String
  customer                    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId                    String?
  branch                      Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  riderId                     String?
  rider                       Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  orderNumber                 String               @unique
  trackingToken               String               @unique
  idempotencyKey              String?
  status                      OrderStatus          @default(PENDING)
  paymentMethod               PaymentMethod
  paymentStatus               PaymentStatus        @default(PENDING)
  fulfilmentType              FulfilmentType
  subtotal                    Decimal              @db.Decimal(10, 2)
  taxAmount                   Decimal              @default(0) @db.Decimal(10, 2)
  deliveryCharge              Decimal              @db.Decimal(10, 2)
  discountAmount              Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount                 Decimal              @db.Decimal(10, 2)
  amountCollected             Decimal?             @db.Decimal(10, 2)
  paymentCollectedAt          DateTime?
  paymentCollectedBy          String?
  paymentNotes                String?
  customerNameSnapshot        String
  customerMobileSnapshot      String
  deliveryAddressSnapshotJson Json?
  customerLatitude            Decimal?             @db.Decimal(10, 7)
  customerLongitude           Decimal?             @db.Decimal(10, 7)
  specialInstructions         String?
  source                      OrderSource          @default(CUSTOMER_PWA)
  placedAt                    DateTime             @default(now())
  acceptedAt                  DateTime?
  preparingAt                 DateTime?
  readyAt                     DateTime?
  outForDeliveryAt            DateTime?
  pickedUpAt                  DateTime?
  deliveredAt                 DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  inventoryRestoredAt         DateTime?
  items                       OrderItem[]
  statusHistory               OrderStatusHistory[]
  feedback                    CustomerFeedback?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([customerId])
  @@index([branchId])
  @@index([riderId])
  @@index([status])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  unitPrice           Decimal  @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(10, 2)
  selectedOptionsJson Json?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedBy      String?
  reason         String?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

model Rider {
  id                 String                  @id @default(uuid())
  companyId          String
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  mobile             String
  email              String?
  vehicleType        String?
  vehicleNumber      String?
  active             Boolean                 @default(true)
  availabilityStatus RiderAvailabilityStatus @default(AVAILABLE)
  secureAccessCode   String                  @unique
  currentOrderId     String?
  notes              String?
  orders             Order[]
  assignments        RiderAssignment[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([companyId])
}

model RiderAssignment {
  id          String    @id @default(uuid())
  orderId     String
  riderId     String
  rider       Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  active      Boolean   @default(true)

  @@index([orderId])
  @@index([riderId])
}

model Promotion {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  description     String?
  type            PromotionType
  fixedDiscount   Decimal?         @db.Decimal(10, 2)
  percentDiscount Decimal?         @db.Decimal(5, 2)
  minimumOrder    Decimal          @default(0) @db.Decimal(10, 2)
  maximumDiscount Decimal?         @db.Decimal(10, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean          @default(true)
  usages          PromotionUsage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId     String
  discount    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, orderId])
}

model CustomerFeedback {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  submittedAt DateTime @default(now())
}

model NotificationEvent {
  id                 String                @id @default(uuid())
  companyId          String
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId            String?
  eventType          NotificationEventType
  channel            String                @default("development-log")
  provider           String                @default("development")
  templateName       String?
  providerMessageId  String?
  recipient          String?
  message            String
  status             String                @default("PENDING")
  attemptCount       Int                   @default(0)
  submittedAt        DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failureCode        String?
  safeFailureMessage String?
  manualFallbackUrl  String?
  dedupeKey          String?
  metadataJson       Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([dedupeKey])
  @@index([companyId])
  @@index([orderId])
  @@index([providerMessageId])
  @@index([status])
}

model WhatsAppInboundMessage {
  id                String   @id @default(uuid())
  companyId         String?
  orderId           String?
  providerMessageId String?  @unique
  fromNumber        String?
  bodyPreview       String?
  payloadJson       Json?
  receivedAt        DateTime @default(now())

  @@index([companyId])
  @@index([orderId])
}

model StudioCampaign {
  id                    String               @id @default(uuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                  String
  campaignType          CampaignType
  objective             String?
  sourceType            String?
  sourceReferenceId     String?
  status                CampaignStatus       @default(DRAFT)
  selectedPlatformsJson Json?
  inputText             String?
  structuredInputJson   Json?
  inputApprovedAt       DateTime?
  creativeBriefJson     Json?
  startDate             DateTime?
  endDate               DateTime?
  mediaAssets           MediaAsset[]
  inputs                CampaignInput[]
  outputs               CampaignOutput[]
  storyboards           Storyboard[]
  processingJobs        MediaProcessingJob[]
  placements            MediaPlacement[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([companyId])
  @@index([productId])
}

model MediaAsset {
  id                     String               @id @default(uuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId             String?
  campaign               StudioCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  productId              String?
  product                Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  parentAssetId          String?
  parentAsset            MediaAsset?          @relation("DerivedMedia", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivedAssets          MediaAsset[]         @relation("DerivedMedia")
  title                  String
  assetType              MediaAssetType
  category               MediaCategory
  sourceType             MediaSourceType      @default(UPLOADED)
  originalFilename       String
  storedFilename         String
  filePath               String
  mimeType               String
  fileSize               Int
  platform               String?
  width                  Int?
  height                 Int?
  durationSeconds        Int?
  metadataJson           Json?
  description            String?
  tagsJson               Json?
  version                Int                  @default(1)
  usageType              StudioMediaUsageType @default(GENERAL_MARKETING)
  approvedForExternalUse Boolean              @default(false)
  approvalStatus         ApprovalStatus       @default(DRAFT)
  approvedAt             DateTime?
  approvedBy             String?
  approvalNotes          String?
  outputs                CampaignOutput[]
  inputJobs              MediaProcessingJob[] @relation("InputMediaJob")
  outputJobs             MediaProcessingJob[] @relation("OutputMediaJob")
  placements             MediaPlacement[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([companyId])
  @@index([campaignId])
  @@index([productId])
  @@index([parentAssetId])
}

model StudioTemplate {
  id                 String   @id @default(uuid())
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  category           String
  templateType       String
  platform           String
  format             String
  width              Int
  height             Int
  previewImagePath   String?
  editableFieldsJson Json?
  brandCompatible    Boolean  @default(true)
  active             Boolean  @default(true)
  tagsJson           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

model StudioSettings {
  id                      String   @id @default(uuid())
  companyId               String   @unique
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultLanguage         String   @default("English")
  defaultPlatformsJson    Json?
  defaultExportFormat     String   @default("original")
  demoAiMode              Boolean  @default(true)
  mediaStorageInfo        String?
  integrationSettingsJson Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model StudioActivity {
  id           String   @id @default(uuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  summary      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([companyId])
}

model CampaignInput {
  id                    String         @id @default(uuid())
  companyId             String
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId            String
  campaign              StudioCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignType          CampaignType
  sourceType            String
  sourceReferenceId     String?
  rawInput              String?
  structuredDetailsJson Json
  missingFieldsJson     Json?
  approved              Boolean        @default(false)
  approvedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([companyId])
  @@index([campaignId])
}

model CampaignOutput {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           StudioCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaAssetId       String?
  mediaAsset         MediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  outputType         StudioOutputType
  platform           String
  headline           String?
  subheadline        String?
  bodyCaption        String?
  cta                String?
  hashtagsJson       Json?
  altText            String?
  reviewWarningsJson Json?
  contentJson        Json?
  status             ApprovalStatus   @default(DRAFT)
  approvedAt         DateTime?
  providerMode       String           @default("demo")
  providerName       String?
  runMetadataJson    Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([companyId])
  @@index([campaignId])
  @@index([mediaAssetId])
}

model Storyboard {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       StudioCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  targetDuration String
  status         ApprovalStatus    @default(DRAFT)
  approvedAt     DateTime?
  scenes         StoryboardScene[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId])
  @@index([campaignId])
}

model StoryboardScene {
  id                   String     @id @default(uuid())
  storyboardId         String
  storyboard           Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  mediaAssetId         String?
  sequenceNumber       Int
  durationSeconds      Int
  scenePurpose         String
  headlineCaption      String
  visualRecommendation String
  transition           String?
  voiceoverText        String?
  musicMood            String?
  cta                  String?
  finalEndCard         Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([storyboardId])
  @@index([mediaAssetId])
}

model MediaProcessingJob {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId         String?
  campaign           StudioCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  inputMediaAssetId  String?
  inputMediaAsset    MediaAsset?     @relation("InputMediaJob", fields: [inputMediaAssetId], references: [id], onDelete: SetNull)
  outputMediaAssetId String?
  outputMediaAsset   MediaAsset?     @relation("OutputMediaJob", fields: [outputMediaAssetId], references: [id], onDelete: SetNull)
  jobType            StudioJobType
  status             StudioJobStatus @default(QUEUED)
  progress           Int             @default(0)
  providerJobId      String?
  publishIntentKey   String?
  attempts           Int             @default(0)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  failureCode        String?
  providerPostId     String?
  publishedUrl       String?
  publishedAt        DateTime?
  configurationJson  Json?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([providerJobId])
  @@unique([publishIntentKey])
  @@index([companyId])
  @@index([campaignId])
  @@index([inputMediaAssetId])
  @@index([outputMediaAssetId])
  @@index([nextRetryAt])
}

model MediaPlacement {
  id             String             @id @default(uuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       StudioCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  mediaAssetId   String
  mediaAsset     MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  productId      String?
  placement      MediaPlacementType
  linkedTargetId String?
  cta            String?
  destinationUrl String?
  startDate      DateTime?
  endDate        DateTime?
  displayOrder   Int                @default(0)
  active         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId])
  @@index([campaignId])
  @@index([mediaAssetId])
  @@index([productId])
}
